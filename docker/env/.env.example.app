APP_NAME="mini-RAG"
APP_VERSION="0.1"
APP_ENV="development"

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=50
FILE_DEFAULT_CHUNK_SIZE=512000

MONGODB_URL="mongodb://admin:admin@localhost:27017/"
MONGODB_DATABASE="mini-rag"

GENERATION_BACKEND="COHERE"
EMBEDDING_BACKEND="COHERE"

OPEN_AI_KEY=""
OPEND_AI_URL=
COHERE_API_KEY=""

GENERATION_MODLE_ID="command-r7b-12-2024"
EMBEDDING_MODEL_ID="embed-v5.0-fast"
EMBEDDING_MODEL_SIZE=512

INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1


# ================ Vector DB Config ======================= #
VECTOR_DB_BACKEND_LITREAL=["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_NAME="qdrant_db"
VECTOR_DB_URL="http://qdrant:6333"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVECTOR_INDEX_THRESHOLD=100

# ================= Template config ============= #
PRIMARY_LANG="en"
DEFAULT_LANG="en"

# =================== postgres =================== #

POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=pgvector
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=minirag

